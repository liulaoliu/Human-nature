# 依赖和构建产物
node_modules/
dist/
tsconfig.tsbuildinfo

# 抽取脚本的产物：从杂志 PDF 抽出来的正文，属于版权内容，不进仓库
# （需要时本地跑 tools/extract-articles.py 生成）
public/articles.json

# 跟读状态快照（「存入项目」写出的，含你改过的正文）。本地保留即可，默认不进仓库；
# 想靠 git 带到新机器的话，改用它自带的「导出备份」更干净。
public/shadowing-state.json

# Python
__pycache__/
*.pyc

# 临时文件：时长表、诊断脚本输出
*.tsv
*.pdf
*.wav
server/*.pid

# 本地图片素材（不进仓库）
assets/imgs/fish/

# 本地词典数据（不进仓库）
data/

# AI 工作包 / 结果（本地约定目录，不进仓库）
new/

# 本机 agent 工作目录（记忆 / 临时缓存），不进仓库
.workbuddy/

# 本机删除文件时留下的回收站目录（tools/safe-delete 之类的守护进程会建），不进仓库
.Trash-*/

# 跑测试时的临时转换缓存（TEMP/TMP 指到工作区内，避免沙箱 EPERM）
.tmp-vitest/

# 本机私密配置：放 API key 的地方，绝不进仓库！
# （config.json 是被跟踪的，别把 key 写进去）
config.local.json
.env
.env.*
!.env.example
public/ecdict.tsv
public/ecdict-forms.tsv
public/ecdict-near.tsv
public/mwld.tsv
public/tts/
