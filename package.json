{
  "name": "xueba-laoge",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "node server/appServer.ts",
    "ai:pack": "node tools/ai-pack.mjs",
    "ai:agent": "node tools/ai-agent.mjs",
    "ecdict:build": "node tools/build-ecdict.mjs",
    "mwld:build": "node tools/build-mwld.mjs",
    "tatoeba:build": "node tools/build-tatoeba.mjs",
    "gates": "tsc -b && npm run typecheck:server && vitest run --pool=forks --maxWorkers=4 --minWorkers=1 && npm run gates:static",
    "gates:full": "npm run gates",
    "gates:fast": "tsc -b && npm run typecheck:server && node tool/test_changed.mjs && npm run gates:static",
    "gates:static": "node tool/check_text_files.mjs && node tool/check_god_file.mjs && node tool/check_hook_size.mjs && node tool/check_architecture.mjs && node tool/check_vocab_sense.mjs && npm run lint",
    "gates:core": "tsc -b && vitest run src/core src/adapters --pool=forks --maxWorkers=4 --minWorkers=1",
    "gates:ui": "tsc -b && vitest run src/reader src/ui src/state src/AppRoutes.test.tsx --pool=forks --maxWorkers=4 --minWorkers=1",
    "gates:server": "npm run typecheck:server && vitest run server tools --pool=forks --maxWorkers=4 --minWorkers=1",
    "check:size": "node tool/check_god_file.mjs",
    "check:hooks": "node tool/check_hook_size.mjs",
    "check:arch": "node tool/check_architecture.mjs",
    "check:vocab": "node tool/check_vocab_sense.mjs",
    "check:dev": "node tool/check_dev_modules.mjs",
    "app": "npm run build && node server/appServer.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "lint": "eslint src",
    "check:text": "node tool/check_text_files.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "node-edge-tts": "^1.2.11",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=23.6"
  }
}
